# Copy to .env.local. Without the Supabase values the site builds from src/content and the form uses the email fallback.
# Never commit real values.

# --- Supabase: shared project; this site uses the "housing" schema only ---
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable/anon key (safe in the browser; RLS protects data)
# SUPABASE_SERVICE_ROLE_KEY=            # SECRET. Server only. Never commit, never paste in chat.
# RATE_LIMIT_SALT=                      # long random string, e.g. `openssl rand -hex 32`

# --- Email via Resend (optional until the domain is live; inquiries still save without it) ---
# RESEND_API_KEY=
# INQUIRY_FROM_EMAIL=             # display name and an address on the domain verified in Resend, e.g. "Name <leasing@your-domain>"
# INQUIRY_NOTIFY_EMAILS=          # comma-separated; also editable in /admin → Contact & settings

# --- Spam protection: Cloudflare Turnstile (server check is active once the secret is set) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Inquiry retention (purged when the owner opens /admin) ---
# INQUIRY_RETENTION_MONTHS=24

# --- Tests only: the Playwright server sets this so tests never save inquiries ---
# INQUIRY_DRY_RUN=1
